# Salin ke .env lalu jalankan `php artisan key:generate`.

# --- Aplikasi ---
# Nama yang tampil di judul halaman, struk, dan laporan Excel.
APP_NAME="Kopi Nusa"
# Alamat atau kota kedai, dicetak di bawah nama pada struk.
STORE_ADDRESS=Surabaya
# local untuk pengembangan; production mematikan pelacak query N+1 (preventLazyLoading).
APP_ENV=local
# Kunci enkripsi sesi/cookie. Kosongkan di sini; diisi otomatis oleh `php artisan key:generate`.
APP_KEY=
# true menampilkan detail error. Gunakan false di luar pengembangan (halaman error versi Indonesia).
APP_DEBUG=true
# Alamat aplikasi (Herd: http://sistem-operasional-kedai-kopi.test, artisan serve: http://127.0.0.1:8000).
APP_URL=http://sistem-operasional-kedai-kopi.test

# Zona waktu untuk timestamp, tanggal invoice, dan pengelompokan laporan.
APP_TIMEZONE=Asia/Jakarta
# Bahasa antarmuka dan pesan validasi.
APP_LOCALE=id
# Bahasa cadangan untuk teks yang belum diterjemahkan.
APP_FALLBACK_LOCALE=en
# Lokal data palsu (factory/seeder).
APP_FAKER_LOCALE=id_ID

# Tempat status mode perawatan (`php artisan down`) disimpan.
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Jumlah worker untuk `php artisan serve` (opsional).
# PHP_CLI_SERVER_WORKERS=4

# Biaya hash kata sandi (tes memakai 4 agar cepat).
BCRYPT_ROUNDS=12

# --- Log ---
# Kanal log; `single` menulis ke storage/logs/laravel.log.
LOG_CHANNEL=stack
LOG_STACK=single
# Peringatan deprecation PHP/Laravel tidak dicatat.
LOG_DEPRECATIONS_CHANNEL=null
# Level log minimum (debug, info, warning, error).
LOG_LEVEL=debug

# --- Database (MySQL) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# Database aplikasi. Tes memakai database terpisah `kopi_nusa_test` (lihat phpunit.xml).
DB_DATABASE=kopi_nusa
DB_USERNAME=root
DB_PASSWORD=
# Zona waktu sesi MySQL. Dikunci ke WIB agar DATE()/HOUR() di laporan selalu waktu Jakarta.
DB_TIMEZONE=+07:00

# --- Sesi ---
# Sesi disimpan di tabel `sessions`.
SESSION_DRIVER=database
# Lama sesi tanpa aktivitas, dalam menit.
SESSION_LIFETIME=120
# Enkripsi isi sesi (tidak diperlukan untuk lokal).
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Layanan pendukung ---
# Event broadcasting tidak dipakai; cukup ditulis ke log.
BROADCAST_CONNECTION=log
# Disk default; foto menu disimpan di disk `public` (jalankan `php artisan storage:link`).
FILESYSTEM_DISK=local
# Antrian job (aplikasi ini tidak memakai job antrean; database cukup).
QUEUE_CONNECTION=database

# Penyimpanan cache (termasuk penghitung rate limit login).
CACHE_STORE=database
# CACHE_PREFIX=

# Tidak dipakai aplikasi ini (bawaan Laravel, dibiarkan untuk kelengkapan).
MEMCACHED_HOST=127.0.0.1

# Tidak dipakai aplikasi ini (bawaan Laravel, dibiarkan untuk kelengkapan).
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Email ---
# Email (mis. tautan reset kata sandi) hanya ditulis ke log, tidak dikirim.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Tidak dipakai aplikasi ini (penyimpanan file di Amazon S3).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Nama aplikasi yang bisa dibaca dari JavaScript (Vite).
VITE_APP_NAME="${APP_NAME}"
